# macOS
.DS_Store

# Editor
.vscode/
.idea/
*.swp

# Node / Astro
node_modules/
.astro/
dist/

# Environment
.env
.env.local
.env.*.local

# Logs
*.log
/logs/

# Draft plans (kept local, not committed)
docs/plans/drafts/

# Claude Code: local settings, worktrees, and the active work item stay local;
# shared settings and skills are committed (AGENTS.md § Agent workflow tooling).
.claude/*
!.claude/settings.json
!.claude/skills/

# graphify knowledge-graph output (regenerated; not tracked)
graphify-out/

# Python / Pipeline
.venv/
pipeline/__pycache__/
__pycache__/
*.pyc
uv.lock

# llm-tester runtime artifacts (keys, run outputs, generated matrix)
scripts/llm-tester/.env.poc
scripts/llm-tester/archive/
scripts/llm-tester/matrix-*.md

# SEO inspection runtime artifacts (per-date GSC URL inspection JSONs)
seo-runs/

# Source-report PDFs are kept locally only; transcribe to a committed .md sibling
# (image-based, large, not diff-able). See docs/reports/*.md.
docs/reports/*.pdf

# Cloudflare Worker local state and secrets
.wrangler/
.dev.vars

# Personal data and local-only notes that must never reach the public repo:
# petition signer exports (names and emails) and the Drive-record folders (AGENTS.md).
signatures-*.csv
/exports/
Claude outputs/

# Session handoff notes (CLAUDE.md "Session handoff notes"): local working state, never committed.
/handoff/

# Image candidate drop folder (.claude/skills/image-candidate): downloads land here, the skill files them under media/candidates/.
/image-inbox/
# Candidate image files stay local: the repo is public, and stock licences (Pixabay,
# Unsplash, Pexels) forbid redistributing the files as-is. Only the .yml records are committed.
/media/candidates/*
!/media/candidates/*.yml
!/media/candidates/README.md
