---
// Playlist rail (UI spec § 3.3, § 7.2). Keyboard and selection behaviour
// live in client/tabs.ts; the sticky rail itself is styled in watch.astro.
import { TESTID } from '../../lib/watch/contract';
import type { WatchPlaylistTabsProps } from '../../lib/watch/types';

type Props = WatchPlaylistTabsProps;
const { playlists, selectedSlug } = Astro.props;
---
<div class="watch-rail__head">
  <span class="watch-rail__label" id="watch-playlists-label">Playlists</span><span class="watch-rail__line" aria-hidden="true"></span>
</div>
<div class="watch-tabs" role="tablist" aria-labelledby="watch-playlists-label" aria-orientation="vertical" data-testid={TESTID.tablist}>
  {playlists.map((p) => {
    const selected = p.slug === selectedSlug;
    const describedBy = [p.creator ? `watch-tab-${p.slug}-creator` : null, `watch-tab-${p.slug}-desc`].filter(Boolean).join(' ');
    return (
      <button
        type="button"
        role="tab"
        class="watch-tab"
        id={`watch-tab-${p.slug}`}
        aria-selected={selected ? 'true' : 'false'}
        aria-controls={`watch-panel-${p.slug}`}
        tabindex={selected ? 0 : -1}
        aria-labelledby={`watch-tab-${p.slug}-name`}
        aria-describedby={describedBy}
        data-testid={TESTID.tab}
        data-playlist={p.slug}
      >
        <span class="watch-tab__name" id={`watch-tab-${p.slug}-name`}>{p.name}</span>
        {p.creator && <span class="watch-tab__creator" id={`watch-tab-${p.slug}-creator`}>{p.creator}</span>}
        <span class="watch-tab__desc" id={`watch-tab-${p.slug}-desc`}>{p.description}</span>
      </button>
    );
  })}
</div>

<style>
  .watch-rail__head {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin-bottom: var(--space-sm);
  }

  .watch-rail__label {
    font-size: var(--font-size-xs);
    color: var(--color-section-label);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .watch-rail__line {
    flex: 1 1 auto;
    height: 1px;
    background: var(--color-text-faint);
    opacity: 0.5;
  }

  .watch-tabs {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .watch-tab {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-xs);
    width: 100%;
    min-height: 44px;
    padding: var(--space-sm) var(--space-md);
    border: 0;
    border-left: 3px solid transparent;
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .watch-tab:hover {
    background: var(--color-radio-selected-bg);
  }

  .watch-tab[aria-selected="true"] {
    border-left-color: var(--color-accent);
  }

  .watch-tab__name {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    line-height: var(--line-height-heading);
    color: var(--color-text-muted);
  }

  .watch-tab[aria-selected="true"] .watch-tab__name {
    color: var(--color-text-heading);
    font-weight: 600;
  }

  .watch-tab__creator {
    font-size: var(--font-size-xs);
    color: var(--color-text-faint);
  }

  .watch-tab__desc {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  /* Tablet: the full-width rail has room for name and creator on one line.
     Literal breakpoints: above BREAKPOINT_PHONE_PX, below BREAKPOINT_DESKTOP_PX. */
  @media (min-width: 641px) and (max-width: 1119px) {
    .watch-tab {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: baseline;
      column-gap: var(--space-md);
    }

    .watch-tab__desc {
      flex-basis: 100%;
    }
  }

  /* Literal breakpoint: BREAKPOINT_DESKTOP_PX in contract.ts. The rail's
     focus-ring room is set on the scroll box in watch.astro. */
  @media (min-width: 1120px) {
    .watch-tab__desc {
      -webkit-line-clamp: 3;
      line-clamp: 3;
    }
  }
</style>
