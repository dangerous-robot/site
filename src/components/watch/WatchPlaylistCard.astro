---
// A playlist as a card: first video's thumbnail, name, creator and video
// count, and the description. The switcher shows one in its trigger and one
// per other playlist in its menu.
import { CLASS } from '../../lib/watch/contract';
import { coverSrcset } from '../../lib/watch/images';
import type { WatchPlaylistView } from '../../lib/watch/types';

interface Props {
  playlist: WatchPlaylistView;
  /** Menu entries carry the glyph that marks the playlist holding the video in the player. */
  inMenu?: boolean;
  /** The card shown in the trigger on first paint is above the fold. */
  eager?: boolean;
}

const { playlist, inMenu = false, eager = false } = Astro.props;
const first = playlist.videos[0];
const n = playlist.videos.length;
const byline = [playlist.creator, `${n} ${n === 1 ? 'video' : 'videos'}`].filter(Boolean).join(' · ');
---
<span class="pl-card__thumb">
  {first && <img src={first.cover.src} srcset={coverSrcset(first.cover)} sizes="104px" alt="" loading={eager ? 'eager' : 'lazy'} decoding="async" referrerpolicy="no-referrer" width="480" height="270" />}
</span>
<span class="pl-card__text">
  <span class="pl-card__name">{playlist.name}</span>
  <span class="pl-card__byline">
    {inMenu && (
      <span class={CLASS.optionPlaying} hidden><svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="currentColor" role="img" aria-label="Has the video in the player"><rect x="3" y="10" width="4" height="10" rx="1"></rect><rect x="10" y="4" width="4" height="16" rx="1"></rect><rect x="17" y="13" width="4" height="7" rx="1"></rect></svg></span>
    )}
    <span>{byline}</span>
  </span>
  {playlist.description && <span class="pl-card__desc">{playlist.description}</span>}
</span>
<style>
  .pl-card__thumb {
    position: relative;
    flex: none;
    width: 104px;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
  }

  .pl-card__thumb img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pl-card__text {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .pl-card__name,
  .pl-card__desc {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }

  .pl-card__name {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 600;
    line-height: var(--line-height-heading);
    color: var(--color-text-heading);
  }

  .pl-card__byline {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: var(--font-size-2xs);
    color: var(--color-text-faint);
  }

  .watch-option__playing {
    flex: none;
    display: inline-flex;
    color: var(--color-accent);
  }

  .pl-card__desc {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }
</style>
