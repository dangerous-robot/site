---
// One playlist's video list. client/main.ts shows one panel at a time and
// keeps each playlist's scroll position; row clicks live in client/list.ts.
// The heading is for screen readers and the no-JavaScript page, where every
// panel shows and the switcher does not.
import EmptyState from '../EmptyState.astro';
import VideoRow from './VideoRow.astro';
import { TESTID, youtubePlaylistUrl } from '../../lib/watch/contract';
import type { WatchPanelProps } from '../../lib/watch/types';

type Props = WatchPanelProps;
const { playlist, selected } = Astro.props;
---
<section
  class="watch-panel"
  id={`watch-panel-${playlist.slug}`}
  aria-labelledby={`watch-panel-${playlist.slug}-title`}
  data-testid={TESTID.panel}
  data-playlist={playlist.slug}
  hidden={!selected}
>
  <h2 class="watch-panel__title sr-only" id={`watch-panel-${playlist.slug}-title`}>{playlist.name}</h2>
  {playlist.status === 'ok' ? (
    <ul class="watch-list" role="list" data-testid={TESTID.list}>
      {playlist.videos.map((video) => (
        <li><VideoRow video={video} playlist={playlist} /></li>
      ))}
    </ul>
  ) : playlist.status === 'failed' ? (
    <div class="watch-panel__empty" data-testid={TESTID.empty}>
      <EmptyState message="These videos could not be loaded.">
        <p class="watch-panel__link"><a href={youtubePlaylistUrl(playlist.youtubeId)}>See the playlist on YouTube</a></p>
      </EmptyState>
    </div>
  ) : (
    <div class="watch-panel__empty" data-testid={TESTID.empty}>
      <EmptyState message="This playlist has no public videos right now." />
    </div>
  )}
</section>
<style>
  /* The bottom room lets the last row scroll clear of the floating accessibility button. */
  .watch-list {
    list-style: none;
    margin: 0;
    padding: var(--space-xs) 0 4rem;
  }

  .watch-panel__empty {
    padding: 0 var(--space-md);
  }

  /* Slotted into EmptyState, whose scoped p rule does not reach it. */
  .watch-panel__link {
    margin: var(--space-sm) 0 0;
    font-size: var(--font-size-sm);
  }
</style>
