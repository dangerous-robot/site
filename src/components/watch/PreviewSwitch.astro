---
// "Hover previews: On / Off" (UI spec § 3.3, § 4.5). Rendered hidden:
// client/preview.ts shows it only on mouse devices and sets the checked
// radio from the stored choice and reduce-motion settings. Styles copy
// A11yControl's radio group so the two switches look the same.
import { TESTID } from '../../lib/watch/contract';
---
<div class="watch-switch" data-testid={TESTID.previewSwitch} hidden>
  <span class="watch-switch__label" id="watch-switch-label">Hover previews</span>
  <div class="watch-switch__group" role="radiogroup" aria-labelledby="watch-switch-label" aria-describedby="watch-switch-hint">
    <button type="button" class="watch-switch__radio" role="radio" aria-checked="true" data-value="on">On</button>
    <button type="button" class="watch-switch__radio" role="radio" aria-checked="false" data-value="off">Off</button>
  </div>
  <p class="watch-switch__hint" id="watch-switch-hint" data-testid={TESTID.previewHint} hidden>Off because reduce motion is on.</p>
</div>
<style>
  .watch-switch__label {
    display: block;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--color-section-label);
    margin-bottom: 0.5rem;
    font-family: var(--font-body);
  }

  .watch-switch__group {
    display: flex;
    gap: 0.25rem;
  }

  .watch-switch__radio {
    min-height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 0.75rem;
    font-size: 0.85rem;
    font-weight: 500;
    font-family: var(--font-body);
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    background: transparent;
    color: var(--color-radio-text);
    cursor: pointer;
    transition: background-color 0.1s ease, color 0.1s ease, border-color 0.1s ease;
  }

  .watch-switch__radio:hover {
    background: var(--color-radio-selected-bg);
    color: var(--color-radio-text-selected);
  }

  .watch-switch__radio[aria-checked="true"] {
    background: var(--color-radio-selected-bg);
    border-color: var(--color-radio-selected-border);
    color: var(--color-radio-text-selected);
  }

  .watch-switch__radio:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
  }

  .watch-switch__hint {
    margin: var(--space-xs) 0 0;
    font-size: var(--font-size-2xs);
    color: var(--color-text-faint);
  }

  /* Literal breakpoint: BREAKPOINT_PHONE_PX in contract.ts (phone is 640px and down). */
  @media (max-width: 640px) {
    .watch-switch__radio {
      min-height: 44px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .watch-switch__radio {
      transition: none;
    }
  }

  :global(:root[data-motion="reduce"]) .watch-switch__radio {
    transition: none;
  }
</style>
