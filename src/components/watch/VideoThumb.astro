---
// One video card (UI spec § 3.3, § 4.2). An anchor to YouTube, so it works
// without JavaScript; client/grid.ts turns a plain click into in-page play
// and marks the playing card. The image is the large part of the card; the
// channel, date and description show in the hover popup.
import { TESTID, youtubeWatchUrl } from '../../lib/watch/contract';
import { coverSrcset } from '../../lib/watch/frames';
import type { VideoThumbProps } from '../../lib/watch/types';

type Props = VideoThumbProps;
const { video, playlist, eager } = Astro.props;
// The same video can sit in two playlists, so ids carry the slug.
const idBase = `watch-thumb-${playlist.slug}-${video.id}`;
const meta = [video.channel, video.durationSpoken, `published ${video.publishedText}`].filter(Boolean).join(', ');
---
<a
  class="watch-thumb"
  href={youtubeWatchUrl(video.id, playlist.youtubeId)}
  id={idBase}
  aria-labelledby={`${idBase}-title`}
  aria-describedby={`${idBase}-meta`}
  data-testid={TESTID.thumb}
  data-video-id={video.id}
  data-playlist={playlist.slug}
  data-frame-tier={video.frameTier}
>
  <span class="watch-thumb__media">
    <img
      class="watch-thumb__cover"
      src={video.cover.src}
      srcset={coverSrcset(video.cover)}
      sizes="(max-width: 640px) 100vw, (max-width: 1119px) 50vw, 540px"
      alt=""
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      referrerpolicy="no-referrer"
      width="480"
      height="270"
    />
    {video.durationText && <span class="watch-thumb__duration" aria-hidden="true" data-testid={TESTID.thumbDuration}>{video.durationText}</span>}
  </span>
  <span class="watch-thumb__title" id={`${idBase}-title`} data-testid={TESTID.thumbTitle}>{video.title}</span>
  <span class="watch-thumb__playing" hidden>Playing</span>
  <span class="sr-only" id={`${idBase}-meta`}>{meta}</span>
</a>
<style>
  .watch-thumb {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  /* The global link underline would run under the whole card. */
  .watch-thumb:hover {
    text-decoration: none;
  }

  .watch-thumb__media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    transition: border-color 0.15s;
  }

  .watch-thumb:hover .watch-thumb__media,
  .watch-thumb:focus-visible .watch-thumb__media,
  .watch-thumb[aria-current="true"] .watch-thumb__media {
    border-color: var(--color-accent);
  }

  .watch-thumb[aria-current="true"] .watch-thumb__media {
    box-shadow: 0 0 0 1px var(--color-accent);
  }

  /* Frame layers are created by client/preview.ts, outside Astro's scoping. */
  .watch-thumb__cover,
  .watch-thumb__media :global(.watch-thumb__frame) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .watch-thumb__media :global(.watch-thumb__frame) {
    opacity: 0;
  }

  .watch-thumb__media :global(.watch-thumb__frame.is-shown) {
    opacity: 1;
  }

  /* Only the upper of the two layers fades (FRAME_FADE_MS): in over the
     lower one, or out to reveal it, so the cover never shows between
     frames. client/preview.ts picks layers to match. */
  .watch-thumb__media :global(.watch-thumb__frame + .watch-thumb__frame) {
    transition: opacity 0.2s;
  }

  /* Putting the cover back is instant. */
  .watch-thumb:not([data-previewing]) .watch-thumb__media :global(.watch-thumb__frame) {
    transition: none;
  }

  /* Fixed colours: the badge sits on video imagery in every theme. Above
     the frame layers, which are inserted after it. */
  .watch-thumb__duration {
    position: absolute;
    right: 0.4rem;
    bottom: 0.4rem;
    z-index: 1;
    padding: 0 0.35em;
    border-radius: var(--radius-sm);
    background: rgba(0, 0, 0, 0.8);
    color: #fff;
    font-family: var(--font-mono);
    font-size: var(--font-size-2xs);
    line-height: 1.6;
  }

  :global([data-contrast="high"]) .watch-thumb__duration {
    border: 1px solid #fff;
  }

  .watch-thumb__title {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    margin-top: var(--space-sm);
    font-family: var(--font-heading);
    font-size: 1rem;
    line-height: var(--line-height-heading);
    color: var(--color-text);
  }

  .watch-thumb:hover .watch-thumb__title {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  /* As .post-date (writing/index.astro), in the accent colour. */
  .watch-thumb__playing {
    display: block;
    margin-top: var(--space-xs);
    font-family: var(--font-mono);
    font-size: var(--font-size-2xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
  }

  /* Frames swap without the crossfade under either reduce setting. */
  @media (prefers-reduced-motion: reduce) {
    .watch-thumb__media,
    .watch-thumb__media :global(.watch-thumb__frame + .watch-thumb__frame) {
      transition: none;
    }
  }

  :global([data-motion="reduce"]) .watch-thumb__media,
  :global([data-motion="reduce"]) .watch-thumb__media :global(.watch-thumb__frame + .watch-thumb__frame) {
    transition: none;
  }
</style>
