---
// A petition page's own URL as a QR code, for a reader at a desk to open the
// page on a phone. On the page it carries one caption sentence with the flyer
// link; on the flyer (size="flyer") it is the bare code.
import { qrSvg } from '../lib/qr';
import { FLYER_LINK_TEXT } from '../lib/flyer';

interface Props {
  url: string;
  /** Link to the printable PDF, set only when that PDF exists at build time. */
  flyerHref?: string;
  size?: 'page' | 'flyer';
}
const { url, flyerHref, size = 'page' } = Astro.props;
const svg = await qrSvg(url);
---
<figure class="petition-qr" data-size={size} data-flyer={flyerHref ? '' : undefined}><div class="petition-qr__tile" set:html={svg} />{size === 'page' && <figcaption class="petition-qr__caption"><span class="petition-qr__scan">Scan to open this page on a phone{flyerHref ? ', or ' : '.'}</span>{flyerHref && <><a href={flyerHref}>{FLYER_LINK_TEXT}</a>.</>}</figcaption>}</figure>

<style>
  .petition-qr {
    display: grid;
    gap: var(--space-xs);
    justify-items: start;
    margin: var(--space-lg) 0 0;
  }

  /* No padding: the SVG's own quiet zone and white background are the margin.
     White in every theme, and no theme filter on the SVG or its logo, so the
     code stays black on white for scanners. */
  .petition-qr__tile {
    width: 8rem;
    height: 8rem;
    padding: 0;
    box-sizing: border-box;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  /* :global: the SVG comes in through set:html and lacks the scoped attribute. */
  .petition-qr__tile :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .petition-qr__caption {
    margin: 0;
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  /* A phone is already in hand: drop the code and the scan clause, keep only
     the flyer link (capitalised, since it now starts the line), or nothing. */
  @media (max-width: 640px) {
    [data-size='page'].petition-qr:not([data-flyer]) {
      display: none;
    }
    [data-size='page'] .petition-qr__tile,
    [data-size='page'] .petition-qr__scan {
      display: none;
    }
    .petition-qr__caption::first-letter {
      text-transform: uppercase;
    }
  }

  [data-size='flyer'] {
    margin: 0;
    gap: 0;
  }

  [data-size='flyer'] .petition-qr__tile {
    width: 2.1in;
    height: 2.1in;
    border: 0;
    border-radius: 0;
  }
</style>
