---
import { Check, X, Minus, HelpCircle, ArrowUp, ExternalLink, Link, Scale } from 'lucide-astro';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import ResponsibleAIFilters from './ResponsibleAIFilters.astro';
import type { MatrixCell as Cell, MatrixCellType as CellType, MatrixData, MatrixFeature as Feature } from '../lib/matrixSchema';
import ResponsibleAIEvidenceMark from './ResponsibleAIEvidenceMark.astro';
import ResponsibleAIWePrefer from './ResponsibleAIWePrefer.astro';
import { cellStance, TIER_NAMES, type EvidenceLookups, type Stance } from '../lib/matrixEvidence';

const ICONS: Record<
  Exclude<CellType, 'text' | 'na'>,
  { Icon: AstroComponentFactory; srLabel: string }
> = {
  yes: { Icon: Check, srLabel: 'Yes' },
  no: { Icon: X, srLabel: 'No' },
  partial: { Icon: Minus, srLabel: 'Partial' },
  unknown: { Icon: HelpCircle, srLabel: 'Unknown' },
};

// Visually hidden text that says in words what the stance color shows (WCAG
// 1.4.1): "Yes, what we prefer." / "No. Not what we prefer." / "Partly what
// we prefer." Unknown, n/a and feature-row cells read only the answer.
const STANCE_PHRASE: Record<Stance, string> = {
  good: ', what we prefer.',
  bad: '. Not what we prefer.',
  mixed: '. Partly what we prefer.',
  neutral: '.',
};

const LEGEND: { label: string; aria: string; items: { stance?: Stance; mark?: 'claim' | 'source'; Icon?: AstroComponentFactory; text: string }[] }[] = [
  { label: 'Legend:', aria: 'Symbol legend', items: Object.values(ICONS).map(({ Icon, srLabel }) => ({ Icon, text: srLabel })) },
  {
    label: 'Color:',
    aria: 'Color legend',
    items: [
      { stance: 'good', Icon: Check, text: 'What we prefer' },
      { stance: 'bad', Icon: X, text: 'Not what we prefer' },
      { stance: 'mixed', Icon: Minus, text: 'Partly' },
    ],
  },
  {
    label: 'Evidence:',
    aria: 'Evidence legend',
    items: [
      { mark: 'claim', Icon: Scale, text: TIER_NAMES.claim },
      { mark: 'source', Icon: Link, text: TIER_NAMES.source },
      { text: `No mark: ${TIER_NAMES.none.toLowerCase()}` },
    ],
  },
];

function renderDetail(s: string): string {
  const esc = s
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
  return esc.replace(
    /\[([^\]]+)\]\(([^)\s]+)\)/g,
    (_m, text, url) =>
      `<a href="${url}" target="_blank" rel="noopener noreferrer">${text}</a>`,
  );
}

interface Props {
  data: MatrixData;
  lookups: EvidenceLookups;
  lastModified?: Date;
}

const { data, lookups, lastModified } = Astro.props;

const lastModifiedLabel = lastModified
  ? lastModified.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })
  : undefined;
const lastModifiedISO = lastModified?.toISOString();
const groups = data.groups;
const activeProducts = data.products.filter((p) => p.status === 'active');
const features = data.features;

const featuresByGroup = new Map<string, Feature[]>();
for (const group of groups) featuresByGroup.set(group.key, []);
for (const feature of features) {
  const bucket = featuresByGroup.get(feature.group);
  if (bucket) bucket.push(feature);
}

const initialHiddenProducts = activeProducts
  .filter((p) => p.initially_hidden)
  .map((p) => p.key);
const initialHiddenAttr = initialHiddenProducts.join(' ');
---
<div class="responsible-matrix">
  {data.lede && <p class="lede">{data.lede}</p>}

  <section
    id="comparison-table"
    class="ra-matrix matrix-section"
    data-hidden-product={initialHiddenAttr || undefined}
  >
    <h2>
      Comparison table
      <a href="#top" class="return-top" aria-label="Return to top">
        <ArrowUp size={18} aria-hidden="true" />
      </a>
    </h2>

    <ResponsibleAIFilters
      products={activeProducts}
      initiallyHiddenProducts={initialHiddenProducts}
    />

    <p class="landscape-nudge" aria-hidden="true">Rotate to landscape for the full table.</p>

    <div class="ra-matrix__scroll" role="region" aria-label="Feature comparison matrix" tabindex="0">
      <table class="matrix-table">
        <thead>
          <tr>
            <th scope="col" class="dim-col ra-feature-head">
              <span class="sr-only">Feature</span>
            </th>
            {activeProducts.map((p) => (
              <th scope="col" class="product-col" data-product-key={p.key}>
                <a
                  href={p.url}
                  class="ra-product-link"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {p.name}
                  <ExternalLink size={12} aria-hidden="true" />
                </a>
              </th>
            ))}
          </tr>
        </thead>
        {groups.map((group) => {
          const rows = featuresByGroup.get(group.key) ?? [];
          if (rows.length === 0) return null;
          return (
            <tbody>
              <tr class="ra-group-header">
                <th colspan={1 + activeProducts.length} scope="rowgroup">
                  <div class="ra-group-sticky">{group.label}</div>
                </th>
              </tr>
              {rows.map((feature) => {
                return (
                <tr>
                  <th scope="row" class="dim-label">
                    {feature.label}
                    {feature.ideal && (
                      <div class="we-prefer"><ResponsibleAIWePrefer ideal={feature.ideal} /></div>
                    )}
                  </th>
                  {activeProducts.map((p) => {
                    const cell = feature.cells[p.key] ?? { type: 'na' as CellType };
                    const icon = cell.type in ICONS ? ICONS[cell.type as keyof typeof ICONS] : null;
                    const stance = cellStance(cell, feature);
                    return (
                      <td class={`cell cell--${cell.type} cell--stance-${stance}`} data-product-key={p.key}>
                        {icon && (
                          <span class="cell-inline">
                            <icon.Icon size={18} aria-hidden="true" />
                            <span class="sr-only">{icon.srLabel}</span>
                            {cell.detail && <span class="detail"><Fragment set:html={renderDetail(cell.detail)} /></span>}<span class="sr-only">{STANCE_PHRASE[stance]}</span>
                          </span>
                        )}
                        {cell.type === 'text' && (
                          <span class="detail"><Fragment set:html={renderDetail(cell.detail ?? '')} /><span class="sr-only">{STANCE_PHRASE[stance]}</span></span>
                        )}
                        {cell.type === 'na' && (
                          <span class="na" aria-label="Not applicable">&ndash;</span>
                        )}
                        <ResponsibleAIEvidenceMark cited={cell} product={p} subject={feature} lookups={lookups} />
                      </td>
                    );
                  })}
                </tr>
                );
              })}
            </tbody>
          );
        })}
      </table>
    </div>

    <div class="caption-area">
      {data.caption && (
        <p class="caption">
          {data.caption}
          {lastModifiedLabel && (
            <> Last updated: <time datetime={lastModifiedISO}>{lastModifiedLabel}</time>.</>
          )}
        </p>
      )}
      {LEGEND.map((row) => (
        <div class="legend-row">
          <span class="legend-label">{row.label}</span>
          <ul class="legend" aria-label={row.aria}>
            {row.items.map((item) => (
              <li class:list={['legend-item', item.stance && `legend-item--${item.stance}`, item.mark && `legend-item--mark-${item.mark}`]}>
                {item.Icon && <item.Icon size={18} aria-hidden="true" />}<span>{item.text}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
      <p class="legend-note">Rows without a “We prefer” line compare facts only; we take no position on them.</p>
    </div>
  </section>
</div>

<script>
  function initMatrix(root: HTMLElement) {
    const readSet = (attr: string) => {
      const v = root.getAttribute(attr);
      return new Set(v ? v.split(/\s+/).filter(Boolean) : []);
    };
    const writeSet = (attr: string, set: Set<string>) => {
      if (set.size === 0) root.removeAttribute(attr);
      else root.setAttribute(attr, [...set].join(' '));
    };
    // aria-pressed semantics: pressed === SELECTED/VISIBLE (filled chip);
    // not-pressed === hidden (outline chip). The data model still tracks
    // hidden keys, so pressed = !(key in hidden).
    const syncProducts = () => {
      const hidden = readSet('data-hidden-product');
      root.querySelectorAll<HTMLButtonElement>('[data-filter-product]').forEach((el) => {
        el.setAttribute('aria-pressed', hidden.has(el.dataset.filterProduct!) ? 'false' : 'true');
      });
    };
    // Run sync once on init so chips reflect the SSR'd data-hidden-product
    // state (products with initially_hidden start hidden).
    syncProducts();
    root.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('button');
      if (!btn || !root.contains(btn)) return;
      const d = btn.dataset;
      if (d.filterProduct) {
        const s = readSet('data-hidden-product');
        s.has(d.filterProduct) ? s.delete(d.filterProduct) : s.add(d.filterProduct);
        writeSet('data-hidden-product', s);
        syncProducts();
      } else if (d.filterReset !== undefined) {
        root.removeAttribute('data-hidden-product');
        syncProducts();
      }
    });
  }
  document.querySelectorAll<HTMLElement>('.ra-matrix').forEach(initMatrix);
</script>

<style>
  .responsible-matrix {
    color: var(--color-text);
  }

  .lede {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-xl);
    max-width: 36rem;
  }

  .ra-matrix {
    --ra-feature-col-width: 14rem;
    scroll-margin-top: 5rem;
  }

  .matrix-section h2 {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 400;
    color: var(--color-text-heading);
    margin: 0 0 var(--space-md);
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
  }

  /* No internal scroll wrapper: the table extends past the page container if
     necessary and the page itself handles horizontal overflow. This lets the
     sticky thead actually stick (a contained scroll context broke it) and
     means pinch-zoom-out on mobile reveals more of the table. */
  .ra-matrix__scroll {
    /* intentionally no overflow — see comment above */
  }

  .matrix-table {
    --matrix-rule: color-mix(in srgb, var(--color-border), var(--color-text) 35%);
    width: 100%;
    /* auto layout so product columns grow to fit their natural (nowrap) name;
       the dim column is held to --ra-feature-col-width via max-width + wrap so
       it doesn't widen on the wide-viewport "all products selected" case. */
    table-layout: auto;
    border-collapse: separate;
    border-spacing: 0;
    font-size: var(--font-size-sm);
  }

  .matrix-table th,
  .matrix-table td {
    padding: 0.6rem 0.75rem;
    vertical-align: top;
    text-align: left;
    border-bottom: 1px solid var(--matrix-rule);
    border-right: 1px solid var(--color-border);
  }

  .matrix-table td {
    vertical-align: middle;
  }

  .matrix-table th:last-child,
  .matrix-table td:last-child {
    border-right: 0;
  }

  /* sticky thead — pins below the page nav (--page-nav-stuck-height is set
     by the IntersectionObserver in [...slug].astro when the pill-nav stuck).
     `- 1px` matches the stuck nav's `top: -1px` shift so the two are flush. */
  .matrix-table thead th {
    position: sticky;
    top: calc(var(--page-nav-stuck-height, 0px) - 1px);
    z-index: 2;
    background: var(--color-bg);
    border-bottom: 1px solid var(--matrix-rule);
  }

  /* sticky-left feature column */
  .matrix-table tbody th[scope="row"] {
    position: sticky;
    left: 0;
    z-index: 2;
    background: var(--color-bg);
    border-right: 1px solid var(--matrix-rule);
  }

  [data-contrast="high"] .matrix-table tbody th[scope="row"] {
    border-right-width: 2px;
  }

  /* top-left intersection (sticky-top from thead rule above; sticky-left here) */
  .matrix-table thead .dim-col,
  .matrix-table thead .ra-feature-head {
    left: 0;
    z-index: 3;
    border-right: 1px solid var(--matrix-rule);
  }

  .dim-col {
    width: var(--ra-feature-col-width);
    max-width: var(--ra-feature-col-width);
  }

  .matrix-table tbody th[scope="row"] {
    width: var(--ra-feature-col-width);
    max-width: var(--ra-feature-col-width);
    overflow-wrap: break-word;
  }

  .product-col {
    /* Each product column sizes to its (nowrap) name. 7rem floor keeps the
       narrowest products (e.g. "Euria") from collapsing under their cell
       content; longer names ("Earthly Insight", "TreadLightlyAI") expand
       the column without wrapping. */
    min-width: 7rem;
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 600;
    white-space: nowrap;
    text-transform: none;
    letter-spacing: 0;
  }

  .ra-product-link {
    color: var(--color-text-heading);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
  }

  .ra-product-link :global(svg) {
    color: var(--color-text-faint);
  }

  .ra-product-link:hover,
  .ra-product-link:focus-visible {
    color: var(--color-accent);
  }

  .dim-label {
    font-weight: 400;
    color: var(--color-text-heading);
  }

  /* Group header: the cell itself scrolls with the row, but its inner div is
     position:sticky;left:0 so the label stays anchored. Wrapping the sticky
     onto a div is the cross-browser-reliable pattern; sticky on <th colspan>
     directly is patchy in Chrome/Android. */
  .ra-group-header th {
    padding: 0;
    border-bottom: 1px solid var(--matrix-rule);
    background: color-mix(in srgb, var(--color-accent) 8%, var(--color-bg));
  }

  .ra-group-sticky {
    position: sticky;
    left: 0;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    padding: var(--space-md) 0.75rem 0.4rem;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--font-size-sm);
    color: var(--color-text-heading);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    background: color-mix(in srgb, var(--color-accent) 8%, var(--color-bg));
  }

  .cell {
    color: var(--color-text);
    max-width: 12rem;
    word-break: break-word;
  }

  .cell-inline {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .detail {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  /* The icon's shape carries the answer; its color carries the page's stance
     on that answer, so a "no" is red only where the row prefers "yes". Rows
     with no stance (and unknown or n/a answers) stay in the text color. */
  .cell--stance-good, .legend-item--good { --stance: var(--color-stance-good); }
  .cell--stance-bad, .legend-item--bad { --stance: var(--color-stance-bad); }
  .cell--stance-mixed, .legend-item--mixed { --stance: var(--color-stance-mixed); }
  .cell :global(svg), .legend-item :global(svg) { color: var(--stance, var(--color-text)); flex-shrink: 0; }
  .legend-item--mark-claim :global(svg) { color: var(--color-accent); }
  .legend-item--mark-source :global(svg) { color: var(--color-text-muted); }
  .cell :global(.ev-mark svg) { color: inherit; }

  /* A text cell (models, ownership) has no icon, and the stance colors are
     tuned for icons, not small text (good is under 4.5:1 on the dark
     background), so a dot in the stance color sits before the muted text. */
  .cell--text .detail::before {
    content: '';
    display: inline-block;
    width: 0.5em;
    height: 0.5em;
    margin-right: 0.4em;
    border-radius: 50%;
    background: var(--stance, transparent);
    vertical-align: middle;
  }

  .cell--stance-neutral .detail::before { display: none; }

  /* DR2: the "We prefer" line reuses the legend's former text style. */
  .we-prefer {
    margin-top: 0.15rem;
    font-size: var(--font-size-xs);
    line-height: 1.4;
    /* The global th rule uppercases row labels; this line reads as a sentence. */
    text-transform: none;
    letter-spacing: 0;
  }

  .na {
    color: var(--color-text-faint);
  }

  .product-col :global(svg) {
    color: var(--color-text-faint);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .caption-area {
    margin: var(--space-md) 0 var(--space-xl);
  }

  .caption {
    font-size: var(--font-size-xs);
    color: var(--color-text-faint);
    margin: 0 0 var(--space-sm);
  }

  .legend-row {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .legend-row + .legend-row {
    margin-top: var(--space-xs);
  }

  .legend-label {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .legend {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem var(--space-md);
  }

  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .legend-note {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    margin: var(--space-sm) 0 0;
  }

  /* Mobile: shrink the feature column to fit the longest label word; allow
     the table to extend past the page container so the page
     horizontal-scrolls naturally. */
  @media (max-width: 640px) {
    .ra-matrix {
      --ra-feature-col-width: 7rem;
    }

    .matrix-table {
      min-width: 0;
      font-size: var(--font-size-xs);
    }

    .matrix-table th,
    .matrix-table td {
      padding: 0.5rem 0.5rem;
    }

    .matrix-table tbody th[scope="row"] {
      font-size: var(--font-size-xs);
      word-break: break-word;
      hyphens: auto;
      min-width: 5rem;
    }

    .product-col {
      font-size: var(--font-size-sm);
      /* Keep product names on one line (e.g. "Viro AI" must not wrap). */
      white-space: nowrap;
      min-width: 5rem;
    }

    .ra-group-sticky {
      padding: var(--space-sm) 0.5rem 0.3rem;
    }
  }

  .landscape-nudge {
    display: none;
  }

  @media (max-width: 640px) and (orientation: portrait) {
    .landscape-nudge {
      display: block;
      font-size: var(--font-size-xs);
      color: var(--color-text-faint);
      margin: 0 0 var(--space-sm);
    }
  }

</style>

<style is:global set:html={`
${activeProducts.map((p) => `
  .ra-matrix[data-hidden-product~="${p.key}"] [data-product-key="${p.key}"] { display: none; }
`).join('')}
`} />
