---
// A comma-separated list of source links, each named by its publisher.
import { sourceInfo, type EvidenceLookups } from '../lib/matrixEvidence';

interface Props {
  paths: string[];
  lookups: EvidenceLookups;
}

const { paths, lookups } = Astro.props;
---
{paths.map((path, i) => (
  <>{i > 0 && ', '}<a href={path}>{sourceInfo(path, lookups)?.publisher ?? path}</a></>
))}
