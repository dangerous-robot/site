---
import { ArrowUp } from 'lucide-astro';
import ResponsibleAISourceLinks from './ResponsibleAISourceLinks.astro';
import type { EvidenceLookups } from '../lib/matrixEvidence';
import type { MatrixData } from '../lib/matrixSchema';

type FootnotesData = Pick<MatrixData, 'footnotes'>;

interface Props {
  data: FootnotesData;
  lookups: EvidenceLookups;
}

const { data, lookups } = Astro.props;
const footnotes = data.footnotes ?? [];

const slugify = (s: string) =>
  s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---
{footnotes.length > 0 && (
  <section class="ra-footnotes-section" id="footnotes">
    <h3>
      Footnotes
      <a href="#top" class="return-top" aria-label="Return to top">
        <ArrowUp size={18} aria-hidden="true" />
      </a>
    </h3>
    <ol class="ra-footnotes">
      {footnotes.map((note) => (
        <li id={`fn-${slugify(note.subject)}`}>
          <strong>{note.subject}</strong>
          {note.text}
          <span class="ra-footnotes__sources"><ResponsibleAISourceLinks paths={note.sources} lookups={lookups} /></span>
        </li>
      ))}
    </ol>
  </section>
)}

<style>
  .ra-footnotes-section {
    margin: var(--space-xl) 0 0;
  }

  .ra-footnotes-section h3 {
    font-family: var(--font-heading);
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-text-heading);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0 0 var(--space-sm);
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
  }

  .ra-footnotes {
    margin: 0;
    padding-left: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .ra-footnotes li {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    line-height: 1.55;
    scroll-margin-top: 5rem;
  }

  .ra-footnotes strong {
    display: block;
    color: var(--color-text-heading);
    margin-bottom: var(--space-2xs);
  }

  .ra-footnotes__sources {
    color: var(--color-text-faint);
  }
</style>
