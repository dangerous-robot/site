---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostArticle from '../../components/PostArticle.astro';
import { getPosts, type Post } from '../../lib/writing';
import { postShareImage } from '../../lib/share-image';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props { post: Post }
const { post } = Astro.props;
const { title, description, image } = post.data;
const share = await postShareImage(image);
const { Content } = await render(post);
---
<Base title={title} description={description} layout="reading" {...share}>
  <PostArticle
    {...post.data}
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Writing', href: '/writing' }]}
    back={{ href: '/writing', label: 'All writing' }}
  >
    <Content />
  </PostArticle>
</Base>
