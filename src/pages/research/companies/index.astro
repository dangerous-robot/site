---
import Base from '../../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import EntityCard from '../../../components/EntityCard.astro';
import FilterBar from '../../../components/FilterBar.astro';
import EmptyState from '../../../components/EmptyState.astro';
import PageHeader from '../../../components/PageHeader.astro';

const entities = await getCollection('entities', e => e.data.type === 'company');
const claims = await getCollection('claims', ({ data }) => data.status === 'published');

const cards = entities.map(entity => {
  const entityClaims = claims.filter(c => c.data.entity === entity.id);
  return {
    id: entity.id,
    name: entity.data.name,
    slug: entity.id.split('/').pop()!,
    description: entity.data.description,
    verdicts: entityClaims.map(c => c.data.verdict),
    claimCount: entityClaims.length,
  };
})
  // Entities without a published claim keep their detail pages but stay off this list.
  .filter(card => card.claimCount > 0)
  .sort((a, b) => a.name.localeCompare(b.name));
---
<Base title="Companies" layout="wide">
  <PageHeader variant="index" type="company" title="Companies" />
  {cards.length === 0
    ? <EmptyState message="No companies have published claims yet." />
    : <Fragment>
        <FilterBar
          total={cards.length}
          searchPlaceholder="Search companies…"
          searchDataAttr="data-name"
        />
        <div class="entity-grid" id="entity-grid">
          {cards.map(card => (
            <div data-filterable data-name={card.name.toLowerCase()}>
              <EntityCard
                name={card.name}
                slug={card.slug}
                entityType="company"
                description={card.description}
                verdicts={card.verdicts}
                claimCount={card.claimCount}
              />
            </div>
          ))}
        </div>
        <div id="filter-empty" hidden>
          <EmptyState message="No companies match this filter." />
        </div>
      </Fragment>
  }
</Base>
<style>
.entity-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: var(--space-lg);
}
</style>
