---
// One US Letter sheet per petition, rendered to PDF by `inv flyers`. Print
// only: noindex, out of the sitemap, and no form, count or network calls.
import '@fontsource/space-grotesk/400.css';
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PetitionQr from '../../../components/PetitionQr.astro';
import { getActions, type Action } from '../../../lib/actions';
import { petitionUrl } from '../../../lib/flyer';
import { formatPostDate } from '../../../lib/writing';

export async function getStaticPaths() {
  const actions = await getActions();
  return actions.map((action) => ({ params: { slug: action.id }, props: { action } }));
}

interface Props { action: Action }
const { action } = Astro.props;
const { title, description, author, ai_assisted, pubDate, petition_statement } = action.data;
const { Content } = await render(action);
const pageUrl = petitionUrl(action.id);
---
<Base title={`${title} flyer`} description={description} layout="bare" chrome="minimal" noindex>
  <div class="flyer" data-theme="light">
    <h1 class="flyer__title">{title}</h1>
    <p class="flyer__byline">Written by {author}{ai_assisted && ', with AI assistance'} · {formatPostDate(pubDate)}</p>
    {petition_statement && <blockquote class="flyer__statement">{petition_statement}</blockquote>}
    <div class="flyer__body"><Content /></div>
    <footer class="flyer__sign">
      <PetitionQr url={pageUrl} size="flyer" />
      <div>
        <h2>Sign the pledge</h2>
        <p>Scan the code or go to</p>
        <p class="flyer__url"><span>dangerousrobot.org</span><span>/petitions/{action.id}</span></p>
      </div>
    </footer>
    <div class="flyer__issuer">
      <img src="/dr-logo.png" alt="" width="48" height="48" />
      <span class="flyer__wordmark">Dangerous Robot</span>
    </div>
  </div>
</Base>

<style>
  /* Only in and pt inside .flyer: the root font size is 16, 18 or 20px per
     viewer, so rem would move the layout between machines. Faces are the
     site's shipped fonts with no fallback list, so a missing face shows up in
     pdffonts instead of being substituted. */
  @page {
    size: 8.5in 11in;
    margin: 0;
  }

  /* A spill must become page 2 (the render script refuses it), so no
     overflow: hidden. */
  .flyer {
    width: 8.5in;
    height: 11in;
    margin: 0;
    padding: 0.65in 0.65in 0.55in;
    display: flex;
    flex-direction: column;
    font: 400 10pt/1.4 'Space Grotesk';
    background: #fff;
    color: var(--color-text);
    print-color-adjust: exact;
    -webkit-print-color-adjust: exact;
  }

  .flyer > * {
    flex: none;
  }

  /* The global h1, h2, h3, blockquote and p rules set Georgia, rem sizes and
     heading colours; each is restated here. */
  .flyer h1,
  .flyer h2,
  .flyer h3,
  .flyer blockquote,
  .flyer p {
    font-family: 'Space Grotesk';
    color: var(--color-text);
  }

  .flyer__title {
    font-size: 28pt;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: 0.01em;
    text-wrap: balance;
    margin: 0 0 0.1in;
  }

  .flyer__byline {
    font-size: 7.5pt;
    font-weight: 400;
    line-height: 1.4;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 0.25in;
  }

  .flyer .flyer__byline {
    color: var(--color-text-muted);
  }

  /* Italic is a synthesised oblique: Space Grotesk ships no italic face. */
  .flyer__statement {
    border: 0;
    border-top: 2px solid var(--color-accent);
    padding: 0.2in 0 0;
    font-size: 17pt;
    font-weight: 400;
    font-style: italic;
    line-height: 1.3;
    max-width: 6.3in;
    margin: 0 0 0.3in;
  }

  .flyer__body {
    columns: 2;
    column-gap: 0.4in;
    column-fill: balance;
  }

  /* :global: the Markdown body comes from <Content /> and lacks the scoped attribute. */
  .flyer__body :global(h3) {
    column-span: all;
    font-family: 'Space Grotesk';
    font-size: 10.5pt;
    font-weight: 600;
    line-height: 1.3;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text);
    margin: 0 0 0.12in;
  }

  .flyer__body :global(h3 strong) {
    font-weight: inherit;
  }

  .flyer__body :global(p) {
    font-family: 'Space Grotesk';
    font-size: 10pt;
    line-height: 1.4;
    color: var(--color-text);
    break-inside: avoid;
    margin: 0 0 0.1in;
  }

  /* Only 400 and 600 are loaded; 600 keeps the term from a synthesised bold. */
  .flyer__body :global(p strong) {
    font-weight: 600;
  }

  /* The closing line ("Please consider adding yourself as a signatory.") leads
     into the sign band. */
  .flyer__body :global(p:last-child) {
    column-span: all;
    font-size: 12pt;
    margin: 0.12in 0 0;
  }

  /* margin-top: auto takes the slack, so nothing pools mid-page. */
  .flyer__sign {
    margin-top: auto;
    border-top: 2px solid var(--color-accent);
    padding-top: 0.2in;
    display: grid;
    grid-template-columns: 2.1in 1fr;
    column-gap: 0.4in;
    align-items: center;
  }

  .flyer__sign h2 {
    font-size: 18pt;
    font-weight: 600;
    line-height: 1.15;
    margin: 0 0 0.06in;
  }

  .flyer__sign p {
    font-size: 11.5pt;
    font-weight: 400;
    line-height: 1.3;
    margin: 0 0 0.08in;
  }

  .flyer .flyer__sign p:not(.flyer__url) {
    color: var(--color-text-muted);
  }

  .flyer .flyer__url {
    font-size: 13pt;
    font-weight: 600;
    line-height: 1.25;
    overflow-wrap: normal;
    margin: 0;
  }

  .flyer__url span {
    display: block;
  }

  .flyer__issuer {
    margin-top: 0.25in;
    border-top: 1px solid var(--color-border);
    padding-top: 0.12in;
    display: flex;
    align-items: center;
    gap: 0.12in;
  }

  .flyer__issuer img {
    width: 0.38in;
    height: 0.38in;
  }

  /* The nav's .site-name, in absolute units. */
  .flyer__wordmark {
    font-family: 'Orbitron';
    font-size: 10pt;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.03em;
    color: var(--color-text);
    border-left: 2px solid var(--color-accent);
    padding-left: 0.1in;
  }

  :global(.a11y-root),
  :global(.site-footer) {
    display: none;
  }

  /* Preview the sheet on a grey desk in a browser. */
  @media screen {
    :global(body) {
      background: #888;
    }
    .flyer {
      margin: 2rem auto;
      box-shadow: 0 0 1rem rgb(0 0 0 / 0.3);
    }
  }
</style>
