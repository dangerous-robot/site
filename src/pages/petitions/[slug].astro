---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostArticle from '../../components/PostArticle.astro';
import PetitionSign from '../../components/PetitionSign.astro';
import { getActions, type Action } from '../../lib/actions';
import { postShareImage } from '../../lib/share-image';

export async function getStaticPaths() {
  const actions = await getActions();
  return actions.map((action) => ({ params: { slug: action.id }, props: { action } }));
}

interface Props { action: Action }
const { action } = Astro.props;
const { title, description, petition, petition_statement, image } = action.data;
const share = await postShareImage(image);
const { Content } = await render(action);
---
<Base title={title} description={description} layout="reading" {...share}>
  <PostArticle
    {...action.data}
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Petitions' }]}
    back={{ href: '/', label: 'Home' }}
  >
    <PetitionSign slot="before" slug={petition} statement={petition_statement} />
    <Content />
  </PostArticle>
</Base>
